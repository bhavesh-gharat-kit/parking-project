{
  "name": "mobile-lite",
  "main": "expo/AppEntry",
  "version": "0.1.0",
  "private": true,
  "description": "Pay & Park Lite — thin WebView shell around apps/api's /web frontend. Secondary distribution variant; apps/mobile remains the primary native app.",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "build:dev": "eas build --profile development --platform android",
    "build:preview": "eas build --profile preview --platform android"
  },
  "dependencies": {
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.19",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
