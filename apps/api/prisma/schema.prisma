// ═══════════════════════════════════════════════════════════════════════════
//  Pay & Park — schema v1
//
//  Section references (§n) point at `_/context.txt`; D1-D4 point at
//  `_/decisions.md`. A reviewer should be able to read this file top to bottom
//  and see how the business spec maps onto tables without further explanation.
//
//  Three conventions run through the whole file:
//
//  1. MONEY is an integer count of paise, never a float or Decimal, and every
//     such column is named `...InPaise` (₹70 → 7000). Rationale in
//     `packages/shared/src/money.ts`.
//
//  2. NOTHING IS HARD-DELETED. Rows that stop being offered get `isActive =
//     false`; required relations use `onDelete: Restrict` so a location, rate or
//     vehicle referenced by a booking cannot be deleted out from under a
//     receipt or a revenue report.
//
//  3. BOOKINGS SNAPSHOT their price and package. Admins change rates without an
//     app release (§24), so a booking that re-read the live `ParkingRate` would
//     silently rewrite its own history. See the snapshot block on `Booking`.
//
//  Per D2 there are deliberately NO slot/inventory tables: a booking is
//  {location, vehicle, rate, start, end}. `ParkingLocation.capacity` is a plain
//  number, and nothing here forbids adding a `ParkingSlot` table later — a
//  nullable `slotId` on `Booking` would be the whole change (§8, §25).
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Prisma 7: the connection URL lives in `prisma.config.ts` (env-driven), not
// here. Runtime access goes through the MariaDB driver adapter in `lib/db.ts`.
datasource db {
  provider = "mysql"
}

// ═══════════════════════════════════════════════════════════════════════════
//  IDENTITY  (§4, §5, §19, §22 · D3)
// ═══════════════════════════════════════════════════════════════════════════

/// §4, §19 — set by the backend only. The login screen never offers a role
/// choice; `role` is copied into the Auth.js JWT claims at sign-in (D3).
enum UserRole {
  USER
  ADMIN
}

/// A customer or an admin. One table for both — the same Android binary serves
/// both audiences and branches on `role` after login (§19).
///
/// D3 puts Auth.js on a JWT session strategy, so there are deliberately no
/// `Account` / `Session` / `VerificationToken` tables: nothing needs persisting
/// between requests beyond the user row itself. Google accounts are linked by
/// storing the verified `sub` claim in `googleId`.
model User {
  id String @id @default(cuid())

  /// Login identifier for both providers, and the key a Google sign-in matches
  /// an existing account on. Stored lower-cased.
  email String  @unique
  name  String?

  /// §17 — the receipt shows customer contact information. Not unique: a family
  /// can share a number, and Google sign-ups arrive without one.
  phone String? @db.VarChar(15)

  /// bcrypt hash. NULL for an account that only ever signed in with Google (D3).
  passwordHash String?

  /// The `sub` claim of a Google ID token this backend verified itself (D3 —
  /// the RN app obtains the ID token, the backend validates it).
  googleId String? @unique

  /// Avatar URL from Google, if any.
  imageUrl String? @db.Text

  role UserRole @default(USER)

  /// §22 — "manage/disable users where required". A disabled user keeps their
  /// booking history; they just cannot sign in.
  isActive Boolean @default(true)

  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles   Vehicle[]
  bookings   Booking[]
  pushTokens PushToken[]

  /// Bookings/payments this user acted on as an admin (§21).
  reviewedBookings Booking[]            @relation("BookingReviewedBy")
  verifiedPayments Payment[]            @relation("PaymentVerifiedBy")
  bookingEvents    BookingStatusEvent[] @relation("BookingEventActor")

  /// Who applied for a pass, and passes/payments this user acted on as an
  /// admin (D5, Phase 19).
  passBookings         PassBooking[]
  reviewedPassBookings PassBooking[]     @relation("PassBookingReviewedBy")
  verifiedPassPayments PassPayment[]     @relation("PassPaymentVerifiedBy")
  passBookingEvents    PassStatusEvent[] @relation("PassBookingEventActor")

  @@index([role, isActive])
  @@index([createdAt])
}

/// Phase 15 — a one-time 6-digit code emailed to a signed-out customer who is
/// resetting their password (`POST /api/auth/forgot-password/request-otp`, then
/// `.../verify-otp`). It replaces the "call the parking office" stub that shipped
/// for Thursday.
///
/// Keyed by `email`, not by a `userId` relation, on purpose. `request-otp` has to
/// answer identically whether or not the address belongs to an account — the same
/// account-enumeration reasoning as `INVALID_CREDENTIALS_MESSAGE` in
/// `lib/auth/errors.ts` — and the cleanest way to be sure the handler cannot
/// accidentally branch on "is there a user" before it answers is for this table
/// not to need one. Rows are still only ever written for a real account with a
/// password; nothing here is reachable for an address that has none.
///
/// Deliberately single-purpose. There is no `purpose` discriminator and no
/// `payload` blob, because registration takes no OTP at all — a sign-up logs the
/// customer straight in (`POST /api/auth/register`, unchanged) — so a generic
/// multi-purpose code table would be columns nothing ever writes.
///
/// `codeHash`, not the code: a readable 6-digit code in this table is a password
/// reset for every pending customer to anyone who can run one SELECT.
///
/// The one place the file header's "nothing is hard-deleted" convention does not
/// apply. A spent or superseded code is not business history that a receipt or a
/// revenue report can read — it is dead credential material whose only remaining
/// property is that keeping it is worse than not. So `requestPasswordResetOtp`
/// clears this address's rows before writing a new one, which also means there is
/// at most one live code per email at a time.
model PasswordResetCode {
  id String @id @default(cuid())

  /// Lower-cased, the way `EmailSchema` normalises it and `User.email` stores it.
  email String

  /// bcrypt hash of the 6-digit code, via `lib/auth/password.ts` (cost 12) — the
  /// same hashing the account's own password gets, rather than a second opinion
  /// about hashing living in this codebase.
  codeHash String

  /// Wrong guesses so far. At `OTP_MAX_ATTEMPTS` (5) this code is locked and the
  /// customer must request a new one. This counter is the only thing between a
  /// 6-digit secret and an online brute force: 10 minutes of unlimited guessing
  /// finds a million-space code easily.
  attempts Int @default(0)

  /// Set when the code was spent on a successful reset. A consumed code is never
  /// accepted again, so one emailed code resets one password.
  consumedAt DateTime?

  /// `createdAt + OTP_TTL_MINUTES` (10).
  expiresAt DateTime

  createdAt DateTime @default(now())

  /// The only lookup there is: the newest code for one address, which serves both
  /// the 60-second resend cooldown and the verify step. Composite rather than
  /// `@@index([email])` so the `ORDER BY createdAt DESC` is covered too.
  @@index([email, createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
//  VEHICLES  (§5)
// ═══════════════════════════════════════════════════════════════════════════

/// §5 — "Bike, Car, Other, if required". An enum rather than a lookup table:
/// the business attaches no data to a vehicle type, and both `ParkingRate` and
/// `Booking` key off it. Adding a type is one migration plus one line in
/// `packages/shared/src/enums.ts`, with no change to booking or rate logic.
enum VehicleType {
  BIKE
  CAR
  OTHER
}

/// §5 — a booking is always associated with a vehicle.
model Vehicle {
  id     String @id @default(cuid())
  userId String

  /// Normalised: upper-case, no spaces or dashes ("MH04AB1234"). The shared
  /// `VehicleNumberSchema` does the normalising on the way in.
  number String      @db.VarChar(14)
  type   VehicleType

  /// Optional free text ("Honda Activa") to help a customer tell two bikes apart.
  makeModel String? @db.VarChar(60)

  /// Set once the customer removes the vehicle. Not deleted, because bookings
  /// point at it and the receipt (§17) must stay readable.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]

  /// The same customer cannot register one plate twice. Two different customers
  /// legitimately can (a shared household vehicle), so this is not globally unique.
  @@unique([userId, number])
  @@index([number])
  @@index([userId, isActive])
}

// ═══════════════════════════════════════════════════════════════════════════
//  LOCATIONS  (§3, §6, §23)
// ═══════════════════════════════════════════════════════════════════════════

/// §3, §6, §23 — Kalyan is row one, not a hardcoded assumption. The customer
/// app always renders a location list from this table, so adding Dombivli or
/// Thane later needs no app release.
model ParkingLocation {
  id String @id @default(cuid())

  name String @db.VarChar(120)

  /// Short branch code used as the prefix of a booking number, e.g. "KLY" →
  /// "KLY-260928-0007" (§17, generated in Phase 05).
  code String @unique @db.VarChar(8)

  addressLine String  @db.VarChar(255)
  city        String  @db.VarChar(80)
  state       String  @db.VarChar(80)
  pincode     String? @db.VarChar(10)

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  contactPhone String? @db.VarChar(15)

  /// §6, §23 — an inactive location disappears from the customer's list but
  /// keeps its bookings and rates.
  isActive Boolean @default(true)

  /// §20 — "current parking usage/availability where applicable". A soft
  /// headcount for the admin dashboard, NOT an inventory table (D2). NULL means
  /// the business is not tracking a cap at this branch.
  capacity Int?

  /// §11, §24 — the UPI details the app shows on the payment screen, per branch,
  /// so a second branch can collect into its own account and so changing the QR
  /// never needs an app release. Falls back to the global `AppSetting` keys when
  /// NULL.
  upiVpa        String? @db.VarChar(120)
  upiPayeeName  String? @db.VarChar(120)
  upiQrImageUrl String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rates    ParkingRate[]
  bookings Booking[]

  /// D5, Phase 19 — the pass pricing matrix and passes sold at this branch.
  passPlans    PassPlan[]
  passBookings PassBooking[]

  @@index([isActive])
  @@index([city])
}

// ═══════════════════════════════════════════════════════════════════════════
//  RATES / PACKAGES  (§7, §24)
// ═══════════════════════════════════════════════════════════════════════════

/// §7, §24 — the price list. One row is one thing a customer can buy:
/// "Kalyan · Car · 2 Hours · ₹70".
///
/// This table is the ONLY place a price comes from (§32): the customer never
/// sends an amount, the booking endpoint looks the rate up server-side, and the
/// admin can edit a price here without a new APK (§24).
model ParkingRate {
  id         String @id @default(cuid())
  locationId String

  /// §7 — pricing depends on vehicle type (bike and car differ).
  vehicleType VehicleType

  /// What the customer reads: "1 Hour", "2 Hours", "Full Day" (§7).
  label String @db.VarChar(40)

  /// The authoritative duration. Phase 05 computes `Booking.endTime` from this,
  /// never from parsing `label`. "Full Day" = 1440.
  durationMinutes Int

  /// Integer paise. ₹70 → 7000.
  priceInPaise Int

  /// Display order in the customer's package list (cheapest/shortest first).
  sortOrder Int @default(0)

  /// Retiring a price sets this false. Never delete: bookings reference the row.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  location ParkingLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  bookings Booking[]

  /// One price per (branch, vehicle type, duration) — otherwise "Car, 2 hours"
  /// at Kalyan would be ambiguous and the backend could not pick a price.
  @@unique([locationId, vehicleType, durationMinutes])
  @@index([locationId, vehicleType, isActive])
}

// ═══════════════════════════════════════════════════════════════════════════
//  BOOKINGS  (§9, §14, §15, §16)
// ═══════════════════════════════════════════════════════════════════════════

/// §14 — the booking's own lifecycle. Kept strictly separate from
/// `PaymentStatus`: they answer different questions ("can this vehicle park?"
/// vs "did the money arrive?") and §32 forbids collapsing them.
///
/// The legal transition table is `BOOKING_TRANSITIONS` in
/// `packages/shared/src/bookings.ts`; this is only the value set.
enum BookingStatus {
  /// Created; payment method not chosen yet (Phase 05 stops here).
  PENDING
  /// UPI chosen; waiting for the customer to pay and submit a UTR (§11).
  PENDING_PAYMENT
  /// UTR submitted; admin has not checked the bank/UPI statement yet (§11).
  PAYMENT_VERIFICATION
  /// Cash chosen; waiting for the admin to receive cash at the gate (§12).
  PENDING_APPROVAL
  /// Admin approved. The receipt becomes available (§17).
  CONFIRMED
  /// Admin rejected — money not found, or cash never paid.
  REJECTED
  /// Customer withdrew it.
  CANCELLED
  /// Not carried through in time; released by the sweep (§15).
  EXPIRED
  /// Parking period finished.
  COMPLETED
}

/// §10 — the two methods the MVP supports. §13's future gateway adds a value
/// here and fills the `gateway*` columns already present on `Payment`; nothing
/// needs restructuring.
enum PaymentMethod {
  UPI
  CASH
}

/// §9, §16 — one row per booking a customer makes.
model Booking {
  id String @id @default(cuid())

  /// §17 — human-readable identifier printed on the receipt and searched by the
  /// admin (§21), e.g. "KLY-260928-0007": branch, date, then a 4-digit counter
  /// that resets to 0001 each day per location — a daily token number, not a
  /// random suffix. Generated by `lib/bookings/booking-number.ts` from the
  /// atomic counter in `BookingDailySequence` (`lib/bookings/booking-sequence.ts`),
  /// inside the same transaction as this insert, never shown as the raw cuid.
  bookingNumber String @unique @db.VarChar(24)

  userId     String
  locationId String
  vehicleId  String

  /// Which price list row was applied — kept for traceability and for the admin
  /// to see which package was sold, even after the price changes.
  rateId String

  // ─────────────────────────────────────────────────────────────────────────
  //  SNAPSHOT — values copied at creation time, never re-read from the live
  //  rows above.
  //
  //  Rates are mutable by design (§24) and a customer can rename or remove a
  //  vehicle, so a booking that joined out to `ParkingRate` / `Vehicle` to
  //  render its receipt (§17) or feed a revenue report (§27) would silently
  //  rewrite last week's history the moment the admin edits a price. These
  //  columns are what the receipt and the reports read.
  // ─────────────────────────────────────────────────────────────────────────

  vehicleNumber   String      @db.VarChar(14)
  vehicleType     VehicleType
  rateLabel       String      @db.VarChar(40)
  durationMinutes Int

  /// The payable amount, in paise, fixed at creation. §32: the customer never
  /// supplies this — the backend derives it from `ParkingRate.priceInPaise`.
  amountInPaise Int

  /// §9 — "Start time / End time where applicable". `endTime` is
  /// `startTime + durationMinutes`, computed by the backend.
  startTime DateTime
  endTime   DateTime

  status BookingStatus @default(PENDING)

  /// NULL until the customer picks UPI or cash (Phase 06).
  paymentMethod PaymentMethod?

  /// §15 — `createdAt + booking.expiryMinutes` (default 10) for as long as the
  /// booking is still the customer's to finish. The sweep
  /// (`app/api/cron/expire-bookings`) looks for rows where this has passed while
  /// the status is still one of `SWEEPABLE_BOOKING_STATUSES` — `PENDING` or
  /// `PENDING_PAYMENT`. `lib/bookings/transitions.ts` clears it as soon as the
  /// booking leaves those: once it is waiting on an admin, or is over, there is
  /// nothing left for the sweep to reclaim.
  expiresAt DateTime?

  confirmedAt DateTime?
  rejectedAt  DateTime?
  cancelledAt DateTime?
  completedAt DateTime?
  expiredAt   DateTime?

  /// §21 — which admin approved or rejected this, and why. Kept on the booking
  /// (not only in the event log) so the admin list can show it without a join.
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?   @db.Text

  /// Free-text operational note from the gate.
  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  location   ParkingLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  vehicle    Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  rate       ParkingRate     @relation(fields: [rateId], references: [id], onDelete: Restrict)
  reviewedBy User?           @relation("BookingReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  /// One payment per booking in Phase 1 (one UPI attempt or one cash handover).
  /// A Phase-13 gateway with retries would drop this `@unique` and order by
  /// `createdAt`; nothing else would change.
  payment Payment?

  /// Append-only audit trail (§21).
  statusEvents BookingStatusEvent[]

  /// §16 — the customer's own history, newest first.
  @@index([userId, createdAt])
  /// §21 — the admin's pending-work queue.
  @@index([status, createdAt])
  /// §15 — the expiry sweep.
  @@index([status, expiresAt])
  /// §20, §26, §27 — dashboard and revenue reports, grouped by branch and day.
  @@index([locationId, createdAt])
  @@index([createdAt])
  @@index([vehicleNumber])
}

/// §17 — the atomic per-(location, day) counter backing `Booking.bookingNumber`.
/// One row per branch per day; `lib/bookings/booking-sequence.ts` increments it
/// with `INSERT ... ON DUPLICATE KEY UPDATE` inside the same transaction as the
/// booking insert, so concurrent bookings at one branch on one day can never be
/// handed the same number. `dateStamp` matches the YYMMDD already embedded in
/// the booking number it numbers, not a `DateTime`, since it is a grouping key,
/// never queried as a point in time.
model BookingDailySequence {
  locationId String
  dateStamp  String @db.VarChar(6)
  lastValue  Int    @default(0)

  @@id([locationId, dateStamp])
}

// ═══════════════════════════════════════════════════════════════════════════
//  PAYMENTS  (§10, §11, §12, §13, §14)
// ═══════════════════════════════════════════════════════════════════════════

/// §14 — the money's state, a separate concern from `BookingStatus` (§32).
enum PaymentStatus {
  /// Nothing has arrived: cash booking not yet paid, or UPI QR shown but no UTR.
  PENDING
  /// A UTR was submitted. §32: that is a claim by the customer, not proof.
  VERIFICATION_PENDING
  /// An admin confirmed the money arrived. §27: only this counts as revenue.
  PAID
  /// Reserved for the Phase-13 gateway (§13); unused by UPI-QR and cash.
  FAILED
  /// An admin checked and the money was not there.
  REJECTED
  REFUNDED
}

/// §10-13 — how one booking was paid for.
model Payment {
  id String @id @default(cuid())

  /// One-to-one with the booking; see the note on `Booking.payment`.
  bookingId String @unique

  method PaymentMethod
  status PaymentStatus @default(PENDING)

  /// Copied from the booking so the payment record is self-contained for
  /// reconciliation, in paise.
  amountInPaise Int

  // ── UPI QR + UTR path (§11) ────────────────────────────────────────────
  /// The reference the customer read off GPay/PhonePe/Paytm. §32: information
  /// for the admin to check against the bank statement — entering it must never
  /// move `status` to `PAID`. Indexed, not unique: a duplicate UTR is a
  /// fraud signal for the admin to judge, not a database error at submit time.
  upiUtr           String?   @db.VarChar(32)
  utrSubmittedAt   DateTime?
  /// Which VPA the customer was shown, in case the branch's UPI ID changes later.
  upiPayeeVpa      String?   @db.VarChar(120)
  /// Payment-app screenshot the customer attached alongside the UTR, uploaded to
  /// media-host. Optional (§278-336, Phase 15) — supporting evidence for the
  /// admin, never a replacement for manual verification against the bank
  /// statement.
  utrScreenshotUrl String?   @db.Text

  // ── Cash-at-parking path (§12) ─────────────────────────────────────────
  /// When the admin physically took the cash.
  cashReceivedAt DateTime?

  // ── Admin verification (§11, §12, §21) ─────────────────────────────────
  verifiedById String?
  verifiedAt   DateTime?
  reviewNote   String?   @db.Text

  /// When the money was confirmed. §27 — revenue reports date off this, not off
  /// `Booking.createdAt`, so a booking paid the next morning lands on the right day.
  paidAt     DateTime?
  refundedAt DateTime?

  // ── Future payment gateway (§13) ───────────────────────────────────────
  // Reserved now so adding Razorpay is a migration on this table plus one new
  // `PaymentMethod` value — not a redesign.
  gatewayProvider  String? @db.VarChar(40)
  gatewayOrderId   String? @db.VarChar(120)
  gatewayPaymentId String? @db.VarChar(120)
  /// Raw webhook/callback body, kept verbatim for dispute handling.
  gatewayPayload   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  verifiedBy User?   @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  /// §20 — "UPI pending verification" and "cash pending approval" are two
  /// separate counts on the admin dashboard; this composite serves both.
  @@index([method, status])
  @@index([status])
  @@index([upiUtr])
  /// §27 — revenue by day and by method.
  @@index([paidAt])
}

// ═══════════════════════════════════════════════════════════════════════════
//  AUDIT TRAIL  (§21)
// ═══════════════════════════════════════════════════════════════════════════

/// Append-only log of every booking/payment status change.
///
/// This system takes money on an admin's word ("yes, that UTR is in the
/// statement", "yes, I took the cash"), so who changed what and when is
/// operational evidence, not a nice-to-have: it answers "who approved this
/// booking?" and "the customer says they submitted a different UTR" without a
/// backup restore. Phase 05 writes a row on every transition; Phase 07's
/// approve/reject and Phase 05's expiry sweep do the same.
model BookingStatusEvent {
  id        String @id @default(cuid())
  bookingId String

  fromStatus BookingStatus?
  toStatus   BookingStatus

  fromPaymentStatus PaymentStatus?
  toPaymentStatus   PaymentStatus?

  /// NULL when the actor was the system — i.e. the expiry sweep (§15).
  actorId   String?
  actorRole UserRole?

  /// Rejection reason, submitted UTR, or whatever context the transition carried.
  note String? @db.Text

  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor   User?   @relation("BookingEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
//  PARKING PASSES  (D5 — Phases 19-22)
//
//  A second, parallel booking type sold alongside the daily `Booking` above —
//  a monthly/weekly pass rather than a single parking session. Reuses the
//  account system and the UPI-QR/cash + UTR/screenshot payment pattern (§11,
//  §12, §32), but is new tables end to end: nothing here changes `Booking`/
//  `Payment`.
//
//  D5 point 3 is the one rule worth restating at the top: `PassBooking.
//  startDate`/`endDate` are computed ONCE, at submission (Phase 20), and
//  never recomputed. "Active" vs "Expired" is a read-time comparison against
//  `endDate` — there is deliberately no `EXPIRED`/`COMPLETED` value in
//  `PassBookingStatus` for this reason. Phase 19 only adds the schema and the
//  admin's `PassPlan` pricing screen — nothing below is customer-reachable yet.
// ═══════════════════════════════════════════════════════════════════════════

/// D5 point 2 — which half of the day (or both) a `PassPlan`'s price applies to.
enum ShiftType {
  DAY
  NIGHT
  BOTH
}

/// D5 point 4 — purely which icon/box gets ticked on the printed pass (Phase
/// 22). Customer-selected, cosmetic only: never affects `PassPlan` lookup or
/// price.
enum PassVehicleCategory {
  BULLET
  AVENGER
  SCOOTY
  SPORTS
  CAR
  RICKSHAW
  OTHER
}

/// D5 point 6 — the admin's own classification of the pass holder (वर्गीकरण
/// on the paper form). Never customer-selected, never customer-visible as an
/// input.
enum PassSpecification {
  SPECIAL
  GENERAL
  ODD
}

/// D5 point 6 — which side of the lot the pass holder parks in. Admin-only,
/// set at approval time.
enum PassEntrySide {
  ST_STAND
  COURT_SIDE
}

/// D5 point 3 — deliberately NO `EXPIRED`/`COMPLETED` value: active vs.
/// expired is always derived by comparing `PassBooking.endDate` against today,
/// never a stored transition.
enum PassBookingStatus {
  PENDING
  PENDING_PAYMENT
  PAYMENT_VERIFICATION
  PENDING_APPROVAL
  CONFIRMED
  REJECTED
  CANCELLED
}

/// Revisits D5 point 3 (customer feedback after Phase 19-22 shipped): a plan
/// is no longer always a whole number of calendar months. `MONTHS` keeps the
/// original "snap to month-end" behaviour; `DAYS` is a literal day count
/// clipped to the end of the purchase month (see `lib/passes/validity.ts`).
enum PassDurationUnit {
  MONTHS
  DAYS
}

/// Customer feedback after Phase 20 shipped — this was free text with a
/// best-effort regex match on the printable pass; now a real select so every
/// value lands on an actual box on the printed form. `OTHER` pairs with
/// `PassBooking.occupationOther` for the free-text case the paper form itself
/// allows ("इतर").
enum PassOccupationCategory {
  LAWYER
  SERVANT
  DEVOTEE
  BUSINESSMAN
  SENIOR_CITIZEN
  OTHER
}

/// Same story as `PassOccupationCategory`, for field 8's सुट्टीचे दिवस.
enum PassHolidayOffDay {
  SUNDAY
  SATURDAY
  OTHER
}

/// D5 point 2 — the pass pricing matrix. One row is one thing a customer can
/// buy: "Kalyan · Bike · Day · Monthly · ₹500". Same role as `ParkingRate` for
/// daily bookings, and the only place a pass price comes from (§32): the
/// customer never sends an amount, and the admin can edit a price here
/// without an app/website release.
model PassPlan {
  id         String @id @default(cuid())
  locationId String

  /// D5 point 2 — pricing never varies on the cosmetic `vehicleCategory` on
  /// `PassBooking`, only on this.
  vehicleType VehicleType
  shiftType   ShiftType

  /// Admin-set price-tier name — "Weekly", "15-Day", "Monthly", "3-Month", or
  /// anything else. A price-tier label, not an enforced day count.
  label String @db.VarChar(40)

  /// Which unit `durationValue` counts in. Feeds `PassBooking.startDate`/
  /// `endDate` at submission (`lib/passes/validity.ts`).
  durationUnit PassDurationUnit @default(MONTHS)

  /// `MONTHS`: 1 for a tier that runs to the end of the purchase month, 3 for
  /// a quarter-style tier, etc. `DAYS`: a literal day count starting the
  /// purchase date, clipped to the end of that calendar month — a "15-Day"
  /// plan bought on the 25th is valid for 6 days, not into next month.
  durationValue Int

  /// Integer paise. ₹500 → 50000.
  priceInPaise Int

  /// Display order in the customer's plan list (Phase 20).
  sortOrder Int @default(0)

  /// Retiring a plan sets this false. Never delete: a deactivated plan simply
  /// disappears from the customer list query — any `PassBooking` already
  /// referencing it (snapshot columns below) is unaffected either way.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  location     ParkingLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  passBookings PassBooking[]

  /// One price per (branch, vehicle type, shift, label) — otherwise two
  /// "Monthly" rows for the same branch/vehicle/shift would be ambiguous.
  @@unique([locationId, vehicleType, shiftType, label])
  @@index([locationId, vehicleType, isActive])
}

/// D5 — one row per pass application. `userId` is who applied, kept only for
/// "my passes" lookups (D5 point 1) — never the source of the vehicle/contact
/// fields below, which are free text typed fresh on the form, not pulled from
/// or synced back to `Vehicle`/`User.phone`.
model PassBooking {
  id String @id @default(cuid())

  /// Mirrors `Booking.bookingNumber` — "KLY-PASS-2610-0007": branch code,
  /// YYMM, then a 4-digit counter from `PassMonthlySequence`, resetting each
  /// calendar month per location. Generated by Phase 20 the same way
  /// (`lib/bookings/booking-number.ts`'s pattern), never shown as the raw cuid.
  passNumber String @unique @db.VarChar(28)

  userId     String
  locationId String
  passPlanId String

  // ─────────────────────────────────────────────────────────────────────────
  //  SNAPSHOT — values copied from `PassPlan` at creation time, never re-read
  //  from the live row. Same reasoning as `Booking`'s snapshot block: plans
  //  are mutable by design (D5 point 2), so a pass that joined out to the
  //  live `PassPlan` would silently rewrite its own history the moment the
  //  admin edits a price or retires the tier.
  // ─────────────────────────────────────────────────────────────────────────
  planLabel     String      @db.VarChar(40)
  vehicleType   VehicleType
  shiftType     ShiftType
  durationUnit  PassDurationUnit
  durationValue Int
  amountInPaise Int

  // ─────────────────────────────────────────────────────────────────────────
  //  APPLICATION — free text per D5 point 1. Deliberately NOT validated
  //  against, or written back to, `Vehicle`/`User.phone`/`User` address.
  // ─────────────────────────────────────────────────────────────────────────
  vehicleNumber String @db.VarChar(10)
  mobileNumber  String @db.VarChar(10)
  address       String @db.Text

  /// D5 point 4 — cosmetic only; never read by pricing/validity logic.
  vehicleCategory PassVehicleCategory

  // ─────────────────────────────────────────────────────────────────────────
  //  INFORMATIONAL (D5 point 5) — customer-entered, admin-editable, never read
  //  by any pricing, validity, or eligibility logic.
  // ─────────────────────────────────────────────────────────────────────────
  occupationCategory PassOccupationCategory?
  /// Free text for `occupationCategory = OTHER` — the paper form's own "इतर
  /// (...)" pattern, not a second occupation field.
  occupationOther String? @db.VarChar(60)
  holidayOffDay   PassHolidayOffDay?
  /// Free text for `holidayOffDay = OTHER`, same pattern.
  holidayOffDayOther String?  @db.VarChar(20)
  helmet             Boolean @default(false)
  locker             Boolean @default(false)
  airCheck           Boolean @default(false)
  rickshawParking    Boolean @default(false)
  renewalReference   String?

  /// Customer-declared, purely informational (never enforced) — field 8's
  /// "महिन्यातून एकूण ___ दिवस पार्किंग": roughly how many days this month the
  /// customer expects to park, not a day count the system checks against.
  expectedParkingDays Int?

  /// Field 2's येण्याची वेळ / जाण्याची वेळ — the customer's usual arrival/
  /// leaving time, `"HH:MM"` 24-hour, informational only. Free text rather
  /// than `DateTime`: there is no date attached, just a daily routine.
  entryTime String? @db.VarChar(5)
  exitTime  String? @db.VarChar(5)

  // ─────────────────────────────────────────────────────────────────────────
  //  ADMIN-ONLY (D5 point 6) — nullable: unset until an admin sets them at
  //  approval time. The customer form never offers an input for either.
  // ─────────────────────────────────────────────────────────────────────────
  specification PassSpecification?
  entrySide     PassEntrySide?

  /// D5 point 3 — computed ONCE at submission (Phase 20, via
  /// `packages/shared/src/datetime.ts`'s IST helpers — never a raw UTC
  /// `new Date()`, and never mixed with MySQL's own `NOW()`, which is IST, not
  /// UTC, on this project's DB), never recomputed on confirm/approve. An admin
  /// may hand-edit these after issue (D5 point 8); that manual value is simply
  /// what "active vs. expired" compares against from then on.
  startDate DateTime
  endDate   DateTime

  status PassBookingStatus @default(PENDING)

  /// NULL until the customer picks UPI or cash (Phase 20).
  paymentMethod PaymentMethod?

  /// D5 point 9 — `createdAt + pass.expiryMinutes` for as long as the
  /// application is still the customer's to finish. Phase 20's sweep
  /// (`app/api/cron/expire-passes`) looks for rows where this has passed
  /// while `status` is still `SWEEPABLE_PASS_BOOKING_STATUSES` (`PENDING` or
  /// `PENDING_PAYMENT`), exactly the `Booking.expiresAt` pattern — including
  /// freezing the window in force at creation, so shortening the setting
  /// later never retroactively expires an older application.
  /// `lib/passes/transitions.ts` clears it once the application leaves those
  /// statuses. Per D5 point 3 this has no interaction with `startDate`/
  /// `endDate` above, which are already fixed by then.
  expiresAt DateTime?

  /// D5 point 8 — which admin approved/rejected/edited this, and why. Kept on
  /// the booking (not only in `statusEvents`) so the admin list can show it
  /// without a join, same as `Booking.reviewedById`.
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?   @db.Text

  confirmedAt DateTime?
  rejectedAt  DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  location   ParkingLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  passPlan   PassPlan        @relation(fields: [passPlanId], references: [id], onDelete: Restrict)
  reviewedBy User?           @relation("PassBookingReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  /// One payment per pass application, same reasoning as `Booking.payment`.
  payment PassPayment?

  /// Append-only audit trail (D5 point 8).
  statusEvents PassStatusEvent[]

  /// The customer's own "my passes" list, newest first (D5 point 1).
  @@index([userId, createdAt])
  /// The admin's pending-work queue.
  @@index([status, createdAt])
  /// Phase 20's expiry sweep.
  @@index([status, expiresAt])
  /// Dashboard/reports, grouped by branch.
  @@index([locationId, createdAt])
}

/// The atomic per-(location, month) counter backing `PassBooking.passNumber`,
/// the same race-free idiom as `BookingDailySequence` but keyed by calendar
/// month instead of day — a pass is sold per month, not per day (D5).
/// `yearMonth` matches the YYMM already embedded in the pass number it
/// numbers, e.g. `"2610"`.
model PassMonthlySequence {
  locationId String
  yearMonth  String @db.VarChar(4)
  lastValue  Int    @default(0)

  @@id([locationId, yearMonth])
}

/// Mirrors `Payment` exactly, keyed to `PassBooking` instead of `Booking`. No
/// `gateway*` columns: a payment gateway for passes is out of scope for this
/// module (unlike `Payment`'s reserved columns for a future Razorpay path).
model PassPayment {
  id            String @id @default(cuid())
  passBookingId String @unique

  method PaymentMethod
  status PaymentStatus @default(PENDING)

  /// Copied from the pass booking so this record is self-contained for
  /// reconciliation, in paise.
  amountInPaise Int

  // ── UPI QR + UTR path ──────────────────────────────────────────────────
  upiUtr           String?   @db.VarChar(32)
  utrSubmittedAt   DateTime?
  upiPayeeVpa      String?   @db.VarChar(120)
  utrScreenshotUrl String?   @db.Text

  // ── Cash-at-counter path ───────────────────────────────────────────────
  cashReceivedAt DateTime?

  // ── Admin verification ─────────────────────────────────────────────────
  verifiedById String?
  verifiedAt   DateTime?
  reviewNote   String?   @db.Text

  paidAt     DateTime?
  refundedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passBooking PassBooking @relation(fields: [passBookingId], references: [id], onDelete: Cascade)
  verifiedBy  User?       @relation("PassPaymentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([method, status])
  @@index([status])
  @@index([upiUtr])
  @@index([paidAt])
}

/// Mirrors `BookingStatusEvent`. Also carries plain field-level edits (Phase
/// 21 — D5 point 8: an admin can edit every field on an issued pass, not only
/// transition its status) via `changedFields`, a before/after diff.
model PassStatusEvent {
  id            String @id @default(cuid())
  passBookingId String

  /// Both NULL together means this row is a plain field edit (Phase 21, D5
  /// point 8), not a status transition — `changedFields` below carries what
  /// actually happened instead. A real transition always sets `toStatus`.
  fromStatus PassBookingStatus?
  toStatus   PassBookingStatus?

  /// NULL when the actor was the system (no sweep exists for passes today,
  /// per D5 point 9 — reserved for parity with `BookingStatusEvent`).
  actorId   String?
  actorRole UserRole?

  /// Rejection reason, submitted UTR, or whatever context the change carried.
  note String? @db.Text

  /// Before/after diff for a plain field edit (Phase 21), e.g.
  /// `{"startDate": {"from": "2026-10-01T...", "to": "2026-10-05T..."}}`. NULL
  /// for a pure status transition that changed nothing else.
  changedFields Json?

  createdAt DateTime @default(now())

  passBooking PassBooking @relation(fields: [passBookingId], references: [id], onDelete: Cascade)
  actor       User?       @relation("PassBookingEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([passBookingId, createdAt])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
//  PUSH NOTIFICATIONS  (D4 — wired up in Phase 09)
// ═══════════════════════════════════════════════════════════════════════════

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

/// D4 — one row per device, not per user, because a customer may install the app
/// on a phone and a tablet. Unused until Phase 09; present now so that phase is
/// a route handler and a send call rather than a migration during launch week.
model PushToken {
  id     String @id @default(cuid())
  userId String

  /// An Expo push token, "ExponentPushToken[xxxxx]". Unique: if the same device
  /// token reappears under a different account it should move, not duplicate.
  token String @unique @db.VarChar(255)

  platform   DevicePlatform @default(ANDROID)
  deviceName String?        @db.VarChar(120)

  /// Expo reports `DeviceNotRegistered` for uninstalled apps; Phase 09 flips this
  /// to false rather than deleting, so a reinstall can be told apart from a
  /// never-registered device.
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

// ═══════════════════════════════════════════════════════════════════════════
//  SETTINGS
// ═══════════════════════════════════════════════════════════════════════════

/// Admin-editable business settings, so the things printed on a receipt or shown
/// on the payment screen are not baked into the APK (the point of §24).
///
/// Known keys (see `lib/settings.ts` once Phase 04 adds the admin screen):
///   business.name              — receipt header (§17)
///   business.supportPhone      — receipt footer (§17)
///   payment.upi.vpa            — global UPI fallback when a location has none (§11)
///   payment.upi.payeeName      — global UPI payee-name fallback
///   booking.expiryMinutes      — overrides BOOKING_EXPIRY_MINUTES (§15)
///
/// A key-value table rather than a one-row settings model: new keys need no
/// migration, and nothing here is queried or joined on.
model AppSetting {
  key   String @id @db.VarChar(80)
  value String @db.Text

  updatedAt DateTime @updatedAt
}
