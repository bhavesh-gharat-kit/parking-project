# Most patterns live in the repo-root .gitignore; these are api-specific.

# Next.js build output
/.next/
/out/
/build

# Prisma's generated client — regenerated by `npm run db:generate`, and by
# `npm run build` before `next build`. Never committed: it is derived from
# prisma/schema.prisma and is platform/version specific.
/generated/

# Env files. `.env.example` is the committed template.
.env
.env.*
!.env.example

# TypeScript
*.tsbuildinfo
next-env.d.ts

# The sideloaded APK /download-apk serves (see public/README.md) — a large
# binary that changes every release, not something to version-control.
public/*.apk

# UTR screenshots written by lib/upload/localProvider.ts when
# STORAGE_PROVIDER=local (see public/README.md) — user-uploaded, not source.
public/uploads/*
!public/uploads/.gitkeep
