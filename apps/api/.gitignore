# Most patterns live in the repo-root .gitignore; these are api-specific.

# Next.js build output
/.next/
/out/
/build

# Prisma's generated client — regenerated by `npm run db:generate`, and by
# `npm run build` before `next build`. Never committed: it is derived from
# prisma/schema.prisma and is platform/version specific.
/generated/

# Env files. `.env.example` is the committed template.
.env
.env.*
!.env.example

# TypeScript
*.tsbuildinfo
next-env.d.ts
