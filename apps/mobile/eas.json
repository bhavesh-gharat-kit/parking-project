{
  "$schema": "https://raw.githubusercontent.com/expo/eas-cli/main/schema/eas.schema.json",
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "development",
        "EAS_PROJECT_ID": "17ed2d4d-71eb-4698-b7bd-e8b2b47a17e3"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_API_BASE_URL": "https://parking-app.kumarinfotech.com",
        "EXPO_PUBLIC_API_TIMEOUT_SECONDS": "20",
        "EAS_PROJECT_ID": "17ed2d4d-71eb-4698-b7bd-e8b2b47a17e3"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_VARIANT": "production",
        "EAS_PROJECT_ID": "17ed2d4d-71eb-4698-b7bd-e8b2b47a17e3"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
